# Upstream catalog clone, ~733MB. Only needed to regenerate web/data:
#   git clone --depth 1 https://github.com/ChristopherLloyd/LooPindex.git reference/LooPindex
#   python3 games/unpinning/tools/extract_levels.py
reference/

# games/*/data is generated, but committed on purpose: rebuilding Unpinning's
# needs the 733MB clone above, so ignoring it would leave a fresh checkout
# unable to run the game at all.

__pycache__/
*.pyc
.DS_Store
